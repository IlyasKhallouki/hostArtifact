# Copy to infra/config.env and fill in your deployment settings.
# Keep infra/config.env private; it is ignored by Git.
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
REGION=europe-west1
ORG_DISPLAY_NAME="Example organization"
ADMIN_CONTACT=admin@example.com
ALLOWED_EMAIL_DOMAINS=example.com
ALLOWED_EMAILS=
ADMIN_EMAILS=admin@example.com
GOOGLE_WORKSPACE=false
PLUGIN_NAME=artifact-publisher
PLUGIN_DISPLAY_NAME="Artifact Publisher"
API_SERVICE=artifact-publisher-api
VIEWER_SERVICE=share
FIRESTORE_DATABASE=artifact-publisher
BUCKET=
AR_REPO=artifact-publisher
DEFAULT_ACCESS_MODE=link
MAX_HTML_BYTES=2000000
DOMAIN_STRATEGY=load-balancer
DNS_PROVIDER_DEFAULT=squarespace
SUGGESTED_SUBDOMAIN=share

# Optional automatic page analytics; credential goes in Secret Manager.
UMAMI_ENABLED=false
UMAMI_URL=
UMAMI_API_URL=
UMAMI_SCRIPT_URL=
UMAMI_TEAM_ID=
